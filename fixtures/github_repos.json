{
  "repositories": [
    {
      "name": "web-app",
      "full_name": "example-org/web-app",
      "private": true,
      "default_branch": {
        "name": "main",
        "protection_enabled": true,
        "required_approving_review_count": 2,
        "dismiss_stale_reviews": true
      }
    },
    {
      "name": "mobile-app",
      "full_name": "example-org/mobile-app",
      "private": true,
      "default_branch": {
        "name": "main",
        "protection_enabled": true,
        "required_approving_review_count": 1,
        "dismiss_stale_reviews": false
      }
    },
    {
      "name": "internal-tools",
      "full_name": "example-org/internal-tools",
      "private": true,
      "default_branch": {
        "name": "master",
        "protection_enabled": false
      }
    }
  ]
}
